{%- liquid
  assign cmp_product = product
  if request.visual_preview_mode and cmp_product == blank
    assign cmp_product = collections.all.products.first
  endif

  assign rows = cmp_product.metafields.custom.comparison_rows.value
  assign competitors = cmp_product.metafields.custom.competitors.value

  comment
    custom.competitors_title es un metaobjeto con los campos title y subtitle
    (o una lista de ellos: se usa el primero). Si faltan, se usan los ajustes de la sección.
  endcomment
  assign titles_entry = cmp_product.metafields.custom.competitors_title.value
  if titles_entry.title == blank and titles_entry.subtitle == blank
    assign titles_entry = titles_entry.first
  endif
  assign cmp_heading = titles_entry.title.value | default: section.settings.heading
  assign cmp_subheading = titles_entry.subtitle.value | default: section.settings.subheading
  assign cmp_outro = titles_entry.outro.value | default: section.settings.disclaimer
-%}

{%- if rows != blank -%}
  <div class="comparison-table" style="--cmp-highlight: {{ section.settings.highlight_color }}; --cmp-heading: {{ section.settings.heading_color }};">
    <div class="comparison-table__container">
      {%- if cmp_heading != blank or cmp_subheading != blank -%}
        <header class="comparison-table__header">
          {%- if cmp_heading != blank -%}
            <h2 class="comparison-table__heading">{{ cmp_heading | escape }}</h2>
          {%- endif -%}
          {%- if cmp_subheading != blank -%}
            <p class="comparison-table__subheading">{{ cmp_subheading | escape | newline_to_br }}</p>
          {%- endif -%}
        </header>
      {%- endif -%}

      <div class="comparison-table__scroll">
        <div class="comparison-table__wrap">
          <table class="comparison-table__table">
            <colgroup>
              <col style="width: 28%">
              <col style="width: 26%">
              <col style="width: 23%">
              <col style="width: 23%">
            </colgroup>
            <thead>
              <tr>
                <th class="comparison-table__feature-head" scope="col"><span class="visually-hidden">Característica</span></th>
                {%- for competitor in competitors limit: 3 -%}
                  {%- assign head_name = competitor.name.value -%}
                  {%- assign head_image = competitor.image.value -%}
                  <th class="comparison-table__head{% if forloop.first %} comparison-table__head--ours{% endif %}" scope="col">
                    {%- if head_image != blank -%}
                      {{
                        head_image
                        | image_url: width: 400
                        | image_tag:
                          class: 'comparison-table__head-image',
                          loading: 'lazy',
                          widths: '200, 300, 400',
                          sizes: '160px',
                          alt: head_name
                      }}
                    {%- endif -%}
                    <span class="comparison-table__head-name">{{ head_name | escape }}</span>
                  </th>
                {%- endfor -%}
              </tr>
            </thead>
            <tbody>
              {%- for row in rows -%}
                {%- capture packed -%}
                  {{ row.our_value.value | strip }}§§{{ row.competitor_1_value.value | strip }}§§{{ row.competitor_2_value.value | strip }}
                {%- endcapture -%}
                {%- assign values = packed | strip | split: '§§' -%}
                <tr>
                  <th class="comparison-table__feature" scope="row">{{ row.feature_name.value | escape }}</th>
                  {%- for index in (0..2) -%}
                    {%- assign cell = values[index] | strip -%}
                    {%- assign cell_key = cell | downcase -%}
                    <td class="comparison-table__cell{% if index == 0 %} comparison-table__cell--ours{% endif %}">
                      {%- if cell_key == 'check' or cell_key == 'true' or cell_key == '✓' or cell_key == 'yes' or cell_key == 'si' or cell_key == 'sí' -%}
                        <span class="comparison-table__icon comparison-table__icon--check" role="img" aria-label="Sí">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><polyline points="20 6 9 17 4 12"></polyline></svg>
                        </span>
                      {%- elsif cell_key == 'cross' or cell_key == 'false' or cell_key == 'x' or cell_key == '✕' or cell_key == 'no' -%}
                        <span class="comparison-table__icon comparison-table__icon--cross" role="img" aria-label="No">
                          <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                        </span>
                      {%- else -%}
                        <span class="comparison-table__text">{{ cell | escape }}</span>
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            </tbody>
          </table>
        </div>
      </div>

      {%- if cmp_outro != blank -%}
        <p class="comparison-table__disclaimer">{{ cmp_outro | escape | newline_to_br }}</p>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  .comparison-table {
    padding-block: 48px;
  }

  .comparison-table__container {
    max-width: 1100px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  .comparison-table__header {
    max-width: 720px;
    margin: 0 auto 40px;
    text-align: center;
  }

  .comparison-table__heading {
    margin: 0 0 12px;
    font-size: 28px;
    font-weight: 700;
    line-height: 1.2;
    color: var(--cmp-heading, #0E3B2E);
  }

  .comparison-table__subheading {
    margin: 0;
    font-size: 16px;
    line-height: 1.6;
    color: #444;
  }

  .comparison-table__scroll {
    overflow-x: auto;
    padding-block: 20px;
    -webkit-overflow-scrolling: touch;
    scroll-behavior: smooth;
  }

  /* Fixed column widths keep the highlighted column aligned with its background. */
  .comparison-table__wrap {
    position: relative;
    min-width: 720px;
  }

  .comparison-table__wrap::before {
    content: '';
    position: absolute;
    top: -16px;
    bottom: -16px;
    left: 28%;
    width: 26%;
    border-radius: 28px;
    background-color: var(--cmp-highlight, #BFE3D6);
    box-shadow: 0 10px 30px rgba(8, 51, 33, 0.12);
  }

  .comparison-table__table {
    position: relative;
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
  }

  .comparison-table__head {
    padding: 8px 12px 20px;
    vertical-align: bottom;
    text-align: center;
  }

  .comparison-table__head--ours {
    padding-inline: 20px;
  }

  .comparison-table__head-image {
    display: block;
    width: auto;
    max-width: 100%;
    height: 120px;
    margin: 0 auto 14px;
    object-fit: contain;
  }

  .comparison-table__head-name {
    display: block;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
    color: #111;
  }

  .comparison-table__feature {
    padding: 18px 16px 18px 0;
    border-bottom: 1px solid #e5e5e5;
    font-size: 15px;
    font-weight: 600;
    text-align: left;
    color: #222;
  }

  .comparison-table__cell {
    padding: 18px 12px;
    border-bottom: 1px solid #e5e5e5;
    font-size: 15px;
    line-height: 1.4;
    text-align: center;
    vertical-align: middle;
    color: #333;
  }

  .comparison-table__cell--ours {
    padding-inline: 20px;
    border-bottom-color: rgba(8, 51, 33, 0.15);
    font-weight: 600;
    color: #0E3B2E;
  }

  .comparison-table__table tbody tr:last-child .comparison-table__feature,
  .comparison-table__table tbody tr:last-child .comparison-table__cell {
    border-bottom: 0;
  }

  .comparison-table__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
  }

  .comparison-table__icon--check {
    background: #0E3B2E;
    color: #fff;
  }

  .comparison-table__icon--cross {
    background: #e6e8e8;
    color: #a3a9a9;
  }

  .comparison-table__disclaimer {
    max-width: 720px;
    margin: 28px auto 0;
    font-size: 12px;
    line-height: 1.5;
    text-align: center;
    color: #888;
  }

  @media screen and (min-width: 768px) {
    .comparison-table {
      padding-block: 72px;
    }

    .comparison-table__heading {
      font-size: 34px;
    }

    .comparison-table__wrap {
      min-width: 0;
    }

    .comparison-table__scroll {
      overflow-x: visible;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tabla comparativa",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Título (respaldo)",
      "info": "Se usa solo si custom.competitors_title no tiene título."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subtítulo (respaldo)",
      "info": "Se usa solo si custom.competitors_title no tiene subtítulo."
    },
    {
      "type": "header",
      "content": "Pie de tabla"
    },
    {
      "type": "textarea",
      "id": "disclaimer",
      "label": "Nota aclaratoria (respaldo)",
      "info": "Se usa solo si custom.competitors_title no tiene outro."
    },
    {
      "type": "header",
      "content": "Colores"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Color del título",
      "default": "#0E3B2E"
    },
    {
      "type": "color",
      "id": "highlight_color",
      "label": "Fondo de la columna destacada",
      "default": "#BFE3D6"
    }
  ],
  "presets": [
    {
      "name": "Tabla comparativa"
    }
  ]
}
{% endschema %}
