{%- if product.metafields.custom.ingredients_second.value != blank or request.visual_preview_mode -%}
  <div class="product-featured-ingredients-section">
    {% render 'product-featured-ingredients',
      product: product,
      heading: section.settings.heading,
      button_label: section.settings.button_label,
      button_url: section.settings.button_url
    %}
  </div>
{%- endif -%}

{% stylesheet %}
  .product-featured-ingredients-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    max-width: 1200px;
    margin-inline: auto;
    padding-inline: 20px;
  }

  @media screen and (min-width: 768px) {
    .product-featured-ingredients-section {
      padding-inline: 40px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Ingredientes destacados",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "¿Qué contiene este producto?"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Texto del botón",
      "default": "Ver todos los ingredientes"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Enlace del botón"
    }
  ],
  "presets": [
    {
      "name": "Ingredientes destacados"
    }
  ]
}
{% endschema %}
