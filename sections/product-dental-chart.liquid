<div class="dental-chart" style="--dental-chart-bg: {{ section.settings.background_color }};">
  <div class="dental-chart__inner">
    <div class="dental-chart__text">
      {%- if section.settings.heading != blank -%}
        <h2 class="dental-chart__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="dental-chart__body">{{ section.settings.text }}</div>
    </div>
    <figure class="dental-chart__figure">
      <svg viewBox="0 0 400 260" width="100%" role="img" aria-label="{{ section.settings.chart_label | escape }}">
        <line x1="40" y1="20" x2="40" y2="220" stroke="#C9D1CD"></line>
        <line x1="40" y1="220" x2="390" y2="220" stroke="#C9D1CD"></line>
        <line x1="40" y1="70" x2="390" y2="70" stroke="#E2E6E4" stroke-dasharray="3 4"></line>
        <line x1="40" y1="120" x2="390" y2="120" stroke="#E2E6E4" stroke-dasharray="3 4"></line>
        <line x1="40" y1="170" x2="390" y2="170" stroke="#E2E6E4" stroke-dasharray="3 4"></line>
        <path d="M70 220 L100 185 L190 125 L300 72 L380 62 L380 220 Z" fill="#BFE3D6"></path>
        <path d="M100 185 L190 125 L300 72 L380 62" fill="none" stroke="#1E6B4F" stroke-width="3"></path>
        <circle cx="100" cy="185" r="8" fill="#fff" stroke="#1E6B4F" stroke-width="3"></circle>
        <circle cx="190" cy="125" r="8" fill="#fff" stroke="#1E6B4F" stroke-width="3"></circle>
        <circle cx="300" cy="72" r="14" fill="#fff" stroke="#B42318" stroke-width="3"></circle>
        {%- if section.settings.stat != blank -%}
          <rect x="235" y="6" width="132" height="44" rx="6" fill="#9A1F12"></rect>
          <text x="301" y="25" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">{{ section.settings.stat | escape }}</text>
          <text x="301" y="41" text-anchor="middle" font-size="10" fill="#fff">{{ section.settings.stat_label | escape }}</text>
        {%- endif -%}
        <text x="215" y="250" text-anchor="middle" font-size="12" fill="#55665F">{{ section.settings.axis_label | escape }}</text>
      </svg>
      {%- if section.settings.sources != blank -%}
        <figcaption class="dental-chart__sources">{{ section.settings.sources | escape }}</figcaption>
      {%- endif -%}
    </figure>
  </div>
</div>

{% stylesheet %}
  .dental-chart {
    background: var(--dental-chart-bg);
    color: #0E3B2E;
  }

  .dental-chart__inner {
    max-width: 1040px;
    margin-inline: auto;
    padding: 88px 24px;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 40px;
    align-items: center;
  }

  .dental-chart__heading {
    margin: 0 0 16px;
    font-weight: 800;
    font-size: clamp(28px, 3vw, 38px);
    line-height: 1.2;
  }

  .dental-chart__body p {
    margin: 0 0 16px;
  }

  .dental-chart__figure {
    margin: 0;
  }

  .dental-chart__figure text {
    font-family: var(--font-body--family);
  }

  .dental-chart__sources {
    font-size: 12px;
    color: #5F6B66;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .dental-chart__inner {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 56px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Gráfica salud dental",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Unos dientes blancos no garantizan una boca sana" },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>La placa se acumula a diario en todos los perros, incluso bien cuidados. Una vez convertida en sarro, es difícil de eliminar.</p><p>Lo que necesitas es algo que cuide toda la boca todos los días, sin complicaciones.</p>" },
    { "type": "text", "id": "stat", "label": "Dato destacado", "default": "80%" },
    { "type": "text", "id": "stat_label", "label": "Texto del dato", "default": "En perros mayores de 3 años" },
    { "type": "text", "id": "axis_label", "label": "Etiqueta del eje", "default": "Edad del perro (años)" },
    { "type": "text", "id": "chart_label", "label": "Descripción accesible de la gráfica", "default": "Los problemas dentales aumentan con la edad del perro" },
    { "type": "text", "id": "sources", "label": "Fuentes" },
    { "type": "color", "id": "background_color", "label": "Fondo", "default": "#F6F6F6" }
  ],
  "presets": [{ "name": "Gráfica salud dental" }]
}
{% endschema %}
