  .lz-modal__badges { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 12px 24px; }
  .lz-modal__badge { display: flex; align-items: center; gap: 10px; font-size: 14px; font-weight: 700; }
  .lz-modal__badge-img { width: 40px; height: 40px; object-fit: contain; }

  .lz-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .lz-list li { display: flex; gap: 12px; align-items: flex-start; }
  .lz-check { flex: none; margin-top: 3px; color: #1A7F56; }
  .lz-steps { display: flex; flex-direction: column; gap: 16px; margin-block: 8px 14px; }
  .lz-steps__item { display: flex; gap: 14px; align-items: flex-start; }
  .lz-steps__num { flex: none; width: 50px; height: 50px; border-radius: 50%; background: #F2FBF7; border: 1px solid #D7EEE5; color: #1A7F56; font-size: 26px; font-weight: 800; display: flex; align-items: center; justify-content: center; }
  .lz-dose { width: 100%; border-collapse: collapse; font-size: 15px; }
  .lz-dose th { text-align: left; padding: 0 0 10px; font-weight: 600; color: #55665F; }
  .lz-dose td { padding: 14px 0; border-top: 1px solid #E5ECE8; }
  .lz-dose__tip { margin: 14px 0 0; font-size: 14px; color: #55665F; }
  .lz-btn-coral--small { display: inline-flex; min-height: 40px; padding: 0 18px; }
  .lz-videos { display: flex; flex-direction: column; gap: 12px; }
  .lz-videos__heading { margin: 0; font-weight: 800; }
  .lz-videos__row { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(110px, 1fr); gap: 10px; overflow-x: auto; }
  .lz-video { display: flex; flex-direction: column; gap: 6px; font-size: 13px; text-align: center; }
  .lz-video__media { width: 100%; aspect-ratio: 9 / 14; object-fit: cover; border-radius: 8px; background: #CFD8D4; display: block; }
  .lz-chart__img { width: 100%; height: auto; display: block; border-radius: 12px; }
  .lz-icon { display: inline-flex; align-items: center; justify-content: center; width: 22px; height: 22px; border-radius: 50%; }
