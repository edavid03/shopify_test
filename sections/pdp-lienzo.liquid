  .lz-thumb.is-active { border-color: #0E3B2E; }
  .lz-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lz-quote { margin: 4px 0 0; display: flex; gap: 20px; align-items: center; padding: 20px 24px; border-radius: 12px; background: #F2FBF7; border: 1px solid #D7EEE5; }
  .lz-quote__avatar { flex: none; width: 84px; height: 84px; border-radius: 50%; border: 3px solid #0E5B45; background: #BFE3D6; overflow: hidden; }
  .lz-quote__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .lz-quote blockquote { margin: 0; font-size: 17px; font-style: italic; }
  .lz-quote figcaption { margin-top: 10px; font-size: 14px; }

  .lz-buy { display: flex; flex-direction: column; gap: 20px; }
  .lz-buy__head { display: flex; flex-direction: column; gap: 10px; }
  .lz-chips { display: flex; gap: 8px; font-size: 12px; font-weight: 700; }
  .lz-chip { border: 1px solid #2E9E6E; background: #F2FBF7; padding: 2px 10px; border-radius: 999px; }
  .lz-title { margin: 0; font-weight: 800; font-size: clamp(30px, 3.2vw, 40px); line-height: 1.15; color: #0E3B2E; }
  .lz-subtitle { margin: 0; font-size: 18px; }
  .lz-rating { display: flex; align-items: center; gap: 10px; font-size: 14px; text-decoration: none; }
  .lz-rating strong { text-decoration: underline; }
  .lz-stars { background: #00A06B; color: #fff; padding: 0 6px; letter-spacing: 3px; font-size: 13px; }
  .lz-rule { border: 0; border-top: 1px solid #E5ECE8; margin: 0; }

  .lz-tabs { background: #F3F4F3; border-radius: 12px; padding: 6px; }
  .lz-tabs__list { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
