  .lz :focus-visible { outline: 3px solid #EA580C; outline-offset: 2px; }
  .lz-h2 { margin: 0 0 16px; font-weight: 800; font-size: clamp(28px, 3vw, 38px); line-height: 1.2; color: #0E3B2E; }
  .lz-center { text-align: center; }

  .lz-hero { max-width: 1240px; margin: 0 auto; padding: 36px 24px 64px; }
  .lz-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: start; }

  .lz-gallery { display: flex; flex-direction: column; gap: 14px; }
