  .lz-modal__title { margin: 0; font-size: 22px; font-weight: 800; color: #0E3B2E; }
  .lz-modal__close { flex: none; width: 44px; height: 44px; border: 0; border-radius: 50%; background: #fff; color: #0E3B2E; display: flex; align-items: center; justify-content: center; cursor: pointer; }
  .lz-modal__body { padding: 24px; overflow-y: auto; }
