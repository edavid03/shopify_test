  .lz-cta:disabled { background: #8FBBA8; cursor: not-allowed; }
  .lz-assure { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; font-size: 13px; color: #55665F; }

  .lz-acc { border-top: 1px solid #E5ECE8; }
  .lz-acc__item { border-bottom: 1px solid #E5ECE8; }
  .lz-acc__q { list-style: none; display: flex; justify-content: space-between; align-items: center; gap: 16px; min-height: 60px; padding: 16px 0; font-size: 17px; font-weight: 800; cursor: pointer; }
  .lz-acc__q::-webkit-details-marker { display: none; }
  .lz-acc__sign::before { content: '+'; font-weight: 400; font-size: 20px; }
  .lz-acc__item[open] .lz-acc__sign::before { content: '−'; }
  .lz-acc__a { padding: 0 0 20px; }
  .lz-acc__a p { margin: 0 0 12px; }

  .lz-chart { background: #F6F6F6; }
  .lz-chart__inner { max-width: 1040px; margin: 0 auto; padding: 88px 24px; display: grid; grid-template-columns: minmax(0, 1fr); gap: 40px; align-items: center; }
  .lz-chart__text p { margin: 0 0 16px; }
  .lz-chart__fig { margin: 0; }
  .lz-chart__fig text { font-family: var(--font-body--family); }
  .lz-chart__fig figcaption { font-size: 12px; color: #5F6B66; text-align: center; }

  .lz-ing { background: #F2FBF7; }
  .lz-ing__inner { max-width: 1040px; margin: 0 auto; padding: 80px 24px; display: flex; flex-direction: column; align-items: center; }
  .lz-ing__grid { display: grid; grid-template-columns: minmax(0, 1fr); gap: 28px; width: 100%; margin-top: 24px; }
  .lz-ing__card { background: #fff; border: 1px solid #BFE3D6; border-radius: 12px; overflow: hidden; }
  .lz-ing__media { position: relative; aspect-ratio: 3 / 2; background: #BFE3D6; }
  .lz-ing__media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .lz-ing__tag { position: absolute; top: 14px; left: 14px; background: #fff; padding: 2px 10px; border-radius: 999px; font-size: 13px; font-weight: 800; }
  .lz-ing__body { padding: 18px 16px 24px; }
  .lz-ing__body h3 { margin: 0 0 8px; font-size: 18px; font-weight: 800; }
  .lz-ing__body p { margin: 0; font-size: 15px; }

  .lz-trust { background: #0E3B2E; color: #fff; padding: 16px 0; overflow: hidden; font-weight: 700; font-size: 15px; }
  .lz-trust__track { display: flex; width: max-content; animation: lz-trust-scroll var(--lz-trust-duration, 40s) linear infinite; }
  .lz-trust:hover .lz-trust__track { animation-play-state: paused; }
  .lz-trust__group { display: flex; flex: none; }
  .lz-trust__set { display: flex; flex: none; margin: 0; padding: 0; list-style: none; }
  .lz-trust__item { display: flex; align-items: center; gap: 8px; flex: none; padding-inline: 20px; white-space: nowrap; }
  @keyframes lz-trust-scroll { from { transform: translateX(0); } to { transform: translateX(-50%); } }
  @media (prefers-reduced-motion: reduce) {
    .lz-trust--respect .lz-trust__track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; }
    .lz-trust--respect .lz-trust__group[aria-hidden='true'] { display: none; }
    .lz-trust--respect .lz-trust__set--copy { display: none; }
    .lz-trust--respect .lz-trust__set { flex-wrap: wrap; justify-content: center; }
  }

  .lz-compare { max-width: 760px; margin: 0 auto; padding: 88px 24px; }
  .lz-compare__lead { margin: 0 auto 40px; text-align: center; color: #55665F; max-width: 520px; }
  .lz-compare__scroll { overflow-x: auto; }
  .lz-compare__table { width: 100%; min-width: 600px; border-collapse: separate; border-spacing: 0; font-size: 14px; text-align: center; }
  .lz-compare__table thead th { padding: 20px 12px 12px; font-weight: 800; vertical-align: bottom; }
  .lz-compare__table tbody th { text-align: left; padding: 18px 12px; border-bottom: 1px solid #E5ECE8; font-weight: 800; }
  .lz-compare__table tbody td { border-bottom: 1px solid #E5ECE8; padding: 12px; }
  .lz-compare__table td.lz-col-us, .lz-compare__table th.lz-col-us { background: #BFE3D6; border-bottom-color: #BFE3D6; }
  .lz-col-us--top { border-radius: 16px 16px 0 0; }
  .lz-col-us--bottom { border-radius: 0 0 16px 16px; font-weight: 800; }
  .lz-compare__img { display: block; width: 56px; height: 56px; object-fit: contain; margin: 0 auto 8px; border-radius: 10px; background: #fff; }
  .lz-compare__note { margin: 28px 0 0; text-align: center; font-size: 13px; color: #5F6B66; }

  @media screen and (min-width: 900px) {
    .lz-hero__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 52px; }
    .lz-gallery { position: sticky; top: 24px; }
    .lz-chart__inner { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 56px; }
    .lz-ing__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media screen and (max-width: 599px) {
    .lz-gallery__thumbs { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('.lz').forEach((root) => {
    const tabs = root.querySelectorAll('[data-lz-tab]');
    const panels = root.querySelectorAll('[data-lz-panel]');
    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        tabs.forEach((t) => {
          const on = t === tab;
          t.classList.toggle('is-active', on);
          t.setAttribute('aria-selected', on ? 'true' : 'false');
        });
        panels.forEach((p) => { p.hidden = p.dataset.lzPanel !== tab.dataset.lzTab; });
      });
    });

    const main = root.querySelector('[data-lz-main]');
    root.querySelectorAll('[data-lz-thumb]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        if (main) { main.src = thumb.dataset.lzThumb; main.removeAttribute('srcset'); }
        root.querySelectorAll('[data-lz-thumb]').forEach((t) => t.classList.toggle('is-active', t === thumb));
      });
    });

    const modal = root.querySelector('[data-lz-modal]');
    const openers = root.querySelectorAll('[data-lz-modal-open]');
    if (modal && openers.length) {
      let lastOpener = null;
      openers.forEach((opener) => {
        opener.addEventListener('click', () => { lastOpener = opener; modal.showModal(); });
      });
      modal.querySelector('[data-lz-modal-close]')?.addEventListener('click', () => modal.close());
      modal.addEventListener('click', (event) => { if (event.target === modal) modal.close(); });
      modal.addEventListener('close', () => { if (lastOpener) lastOpener.focus(); });
    }

    const priceTarget = root.querySelector('[data-lz-cta-price]');
    root.querySelectorAll('.lz-variant input').forEach((input) => {
      input.addEventListener('change', () => {
        if (priceTarget && input.dataset.lzPrice) priceTarget.textContent = input.dataset.lzPrice;
      });
    });
  });
{% endjavascript %}

