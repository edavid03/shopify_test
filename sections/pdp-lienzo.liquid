{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign mf = product.metafields.custom

  assign display_title = mf.title.value | default: section.settings.headline | default: product.title
  assign subtitle = mf.hero_subtitle.value | default: section.settings.subtitle
  assign header_badges = mf.header_badges.value
  assign benefits_list = mf.benefits_list.value
  assign featured_ingredients = mf.featured_ingredients.value
  assign dosage_table = mf.dosage_table.value
  assign dosage_tip = mf.dosage_tip.value
  assign testimonial = mf.expert_testimonial.value
  assign accordion_items = mf.custom.value
  assign videos = mf.product_videos.value
  assign info = mf.first_nformation.value
  assign ingredients = mf.ingredients_second.value
  assign highlights = mf.ticker_highlights.value
  assign rows = mf.comparison_rows.value
  assign competitors = mf.competitors.value
  assign titles_entry = mf.competitors_title.value
  if titles_entry.first
    assign titles_entry = titles_entry.first
  endif

  assign full_ingredients_content = mf.full_ingredients_content
  assign modal_badges = mf.modal_badges.value
  assign has_modal = false
  if full_ingredients_content != blank or modal_badges != blank
    assign has_modal = true
  endif

  assign part = section.settings.part | default: 'all'
  assign show_hero = false
  assign show_chart = false
  assign show_ing = false
  assign show_trust = false
  assign show_compare = false
  if part == 'all' or part == 'hero'
    assign show_hero = true
  endif
  if part == 'all' or part == 'chart'
    assign show_chart = true
  endif
  if part == 'all' or part == 'ingredients'
    assign show_ing = true
  endif
  if part == 'all' or part == 'trust'
    assign show_trust = true
  endif
  if part == 'all' or part == 'compare'
    assign show_compare = true
  endif

  assign ingredient_blocks = section.blocks | where: 'type', 'ingredient'
  assign faq_blocks = section.blocks | where: 'type', 'faq'
  assign compare_blocks = section.blocks | where: 'type', 'compare_row'
  assign trust_blocks = section.blocks | where: 'type', 'trust'

  assign ing_has = false
  if ingredients != blank or ingredient_blocks.size > 0
    assign ing_has = true
  endif
  assign modal_here = false
  if has_modal
    if show_hero or show_ing
      assign modal_here = true
    endif
  endif
  assign cmp_has = false
  if rows != blank or compare_blocks.size > 0
    assign cmp_has = true
  endif
-%}

{%- capture lz_check -%}<svg class="lz-check" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>{%- endcapture -%}

<div class="lz" id="Lienzo-{{ section.id }}">
  {%- if show_hero -%}
  <section class="lz-hero">
    <div class="lz-hero__grid">
      <div class="lz-gallery">
        <div class="lz-gallery__main">
          {%- if section.settings.badge != blank -%}
            <span class="lz-gallery__badge">{{ section.settings.badge | escape }}</span>
          {%- endif -%}
          {%- if product.featured_media -%}
            {{ product.featured_media | image_url: width: 1200 | image_tag: class: 'lz-gallery__img', data-lz-main: '', alt: product.featured_media.alt | default: product.title, sizes: '(min-width: 990px) 50vw, 100vw' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'lz-gallery__img' }}
          {%- endif -%}
          <div class="lz-gallery__pills">
            {%- for i in (1..3) -%}
              {%- assign pill_key = 'pill_' | append: i -%}
              {%- if section.settings[pill_key] != blank -%}
                <span class="lz-pill-dark">{{ section.settings[pill_key] | escape }}</span>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
        {%- if product.media.size > 1 -%}
          <div class="lz-gallery__thumbs">
            {%- for media in product.media limit: 7 -%}
              <button type="button" class="lz-thumb{% if forloop.first %} is-active{% endif %}" data-lz-thumb="{{ media.preview_image | image_url: width: 1200 }}" aria-label="{{ media.alt | default: product.title | escape }}">
                {{ media.preview_image | image_url: width: 160 | image_tag: alt: '' }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- liquid
          assign quote = section.settings.quote
          assign quote_name = section.settings.quote_name
          assign quote_role = section.settings.quote_role
          assign quote_image = section.settings.quote_image
          if testimonial != blank
            assign quote = testimonial.text.value
            assign quote_name = testimonial.name.value
            assign quote_role = testimonial.description.value
            assign quote_image = testimonial.image.value
          endif
        -%}
        {%- if quote != blank -%}
          <figure class="lz-quote">
            <div class="lz-quote__avatar">
              {%- if quote_image != blank -%}
                {{ quote_image | image_url: width: 200 | image_tag: alt: quote_name, loading: 'lazy' }}
              {%- endif -%}
            </div>
            <div>
              <blockquote>{{ quote | escape | newline_to_br }}</blockquote>
              <figcaption><strong>{{ quote_name | escape }}</strong><br>{{ quote_role | escape }}</figcaption>
            </div>
          </figure>
        {%- endif -%}
      </div>

      <div class="lz-buy">
        <div class="lz-buy__head">
          <div class="lz-chips">
            {%- if header_badges != blank -%}
              {%- for badge in header_badges -%}<span class="lz-chip">{{ badge | escape }}</span>{%- endfor -%}
            {%- else -%}
              {%- if section.settings.chip_1 != blank -%}<span class="lz-chip">{{ section.settings.chip_1 | escape }}</span>{%- endif -%}
              {%- if section.settings.chip_2 != blank -%}<span class="lz-chip">{{ section.settings.chip_2 | escape }}</span>{%- endif -%}
            {%- endif -%}
          </div>
          <h1 class="lz-title">{{ display_title | escape }}</h1>
          {%- if subtitle != blank -%}
            <p class="lz-subtitle">{{ subtitle | escape }}</p>
          {%- endif -%}
          {%- if section.settings.review_count != blank -%}
            <a class="lz-rating" href="{{ section.settings.review_url | default: '#' }}">
              <span class="lz-stars" aria-hidden="true">★★★★★</span>
              <span>{{ section.settings.review_intro | escape }} <strong>{{ section.settings.review_count | escape }} {{ section.settings.review_outro | escape }}</strong></span>
            </a>
          {%- endif -%}
        </div>
        <hr class="lz-rule">

        <div class="lz-tabs" data-lz-tabs>
          <div class="lz-tabs__list" role="tablist">
            <button type="button" role="tab" class="lz-tab is-active" aria-selected="true" data-lz-tab="0">{{ section.settings.tab_1_label | escape }}</button>
            <button type="button" role="tab" class="lz-tab" aria-selected="false" data-lz-tab="1">{{ section.settings.tab_2_label | escape }}</button>
            <button type="button" role="tab" class="lz-tab" aria-selected="false" data-lz-tab="2">{{ section.settings.tab_3_label | escape }}</button>
          </div>
          <div class="lz-tabs__panel" role="tabpanel" data-lz-panel="0">
            {%- if benefits_list != blank -%}
              <ul class="lz-list">
                {%- for benefit in benefits_list -%}
                  <li>{{ lz_check }}<span>{{ benefit | escape }}</span></li>
                {%- endfor -%}
              </ul>
            {%- else -%}
              <div class="lz-checks">{{ section.settings.tab_1_content }}</div>
            {%- endif -%}
          </div>
          <div class="lz-tabs__panel" role="tabpanel" data-lz-panel="1" hidden>
            <div class="lz-tab-ingredients">
              <p>{{ section.settings.ingredients_heading | escape }}</p>
              {%- if featured_ingredients != blank -%}
                {%- for ingredient in featured_ingredients -%}
                  <div class="lz-mini-ing">
                    <span class="lz-mini-ing__img">
                      {%- if ingredient.image.value != blank -%}{{ ingredient.image.value | image_url: width: 120 | image_tag: alt: '', loading: 'lazy' }}{%- endif -%}
                    </span>
                    <div><strong>{{ ingredient.name.value | escape }}</strong><br>{{ ingredient.description.value | escape }}</div>
                  </div>
                {%- endfor -%}
              {%- else -%}
                {%- for block in ingredient_blocks limit: 3 -%}
                  <div class="lz-mini-ing">
                    <span class="lz-mini-ing__img">{%- if block.settings.image != blank -%}{{ block.settings.image | image_url: width: 120 | image_tag: alt: '' }}{%- endif -%}</span>
                    <div><strong>{{ block.settings.name | escape }}</strong><br>{{ block.settings.short | escape }}</div>
                  </div>
                {%- endfor -%}
              {%- endif -%}
              {%- if has_modal -%}
                <button type="button" class="lz-btn-coral" aria-haspopup="dialog" aria-controls="LienzoModal-{{ section.id }}" data-lz-modal-open>
                  {{ section.settings.ingredients_button | escape }}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
                </button>
              {%- else -%}
                <a class="lz-btn-coral" href="#LienzoIngredientes">{{ section.settings.ingredients_button | escape }}</a>
              {%- endif -%}
            </div>
          </div>
          <div class="lz-tabs__panel" role="tabpanel" data-lz-panel="2" hidden>
            {%- if dosage_table != blank -%}
              <table class="lz-dose">
                <thead><tr><th scope="col">{{ section.settings.dose_col_1 | escape }}</th><th scope="col">{{ section.settings.dose_col_2 | escape }}</th></tr></thead>
                <tbody>
                  {%- for rule in dosage_table -%}
                    <tr>
                      <td>{{ rule.weight_range.value | escape }}</td>
                      <td>
                        {%- if rule.button_label.value != blank -%}
                          <a class="lz-btn-coral lz-btn-coral--small" href="{{ rule.button_url.value | default: '#' }}">{{ rule.button_label.value | escape }}</a>
                        {%- elsif rule.dosage_text.value != blank -%}
                          {{ rule.dosage_text.value | escape }}
                        {%- elsif rule.scoop_count.value != blank -%}
                          {{ rule.scoop_count.value }} {{ section.settings.scoop_label | escape }}
                        {%- endif -%}
                      </td>
                    </tr>
                  {%- endfor -%}
                </tbody>
              </table>
              {%- if dosage_tip != blank -%}<p class="lz-dose__tip">{{ dosage_tip | escape | newline_to_br }}</p>{%- endif -%}
            {%- else -%}
              <div class="lz-dosage">{{ section.settings.tab_3_content }}</div>
            {%- endif -%}
          </div>
        </div>

        <div class="lz-card">
          <div class="lz-card__inner">
            {%- if section.settings.tip != blank -%}
              <div class="lz-tip">{{ section.settings.tip }}</div>
            {%- endif -%}
            {%- form 'product', product, class: 'lz-form', data-lz-form: '' -%}
              {%- if product.has_only_default_variant == false -%}
                <div class="lz-step">
                  <p class="lz-step__label"><span class="lz-step__num">1</span>{{ section.settings.step_1_label | escape }}</p>
                  <div class="lz-variants">
                    {%- for variant in product.variants -%}
                      <label class="lz-variant">
                        <input type="radio" name="id" value="{{ variant.id }}" {% if variant.id == current_variant.id %}checked{% endif %}{% unless variant.available %} disabled{% endunless %} data-lz-price="{{ variant.price | money }}">
                        <span class="lz-variant__radio" aria-hidden="true"></span>
                        <span class="lz-variant__text">
                          <span class="lz-variant__title">{{ variant.title | escape }}</span>
                          {%- if variant.compare_at_price > variant.price -%}
                            <span class="lz-variant__save">{{ section.settings.save_label | escape }} {{ variant.compare_at_price | minus: variant.price | money }}</span>
                          {%- endif -%}
                        </span>
                        <span class="lz-variant__price">{{ variant.price | money }}</span>
                      </label>
                    {%- endfor -%}
                  </div>
                </div>
              {%- else -%}
                <input type="hidden" name="id" value="{{ current_variant.id }}">
              {%- endif -%}
              <button type="submit" name="add" class="lz-cta"{% unless current_variant.available %} disabled{% endunless %}>
                {%- if current_variant.available -%}
                  {{ section.settings.cta_label | escape }} · <span data-lz-cta-price>{{ current_variant.price | money }}</span>
                {%- else -%}
                  {{ 'products.product.sold_out' | t }}
                {%- endif -%}
              </button>
            {%- endform -%}
            <div class="lz-assure">
              {%- if section.settings.assure_1 != blank -%}<span>{{ section.settings.assure_1 | escape }}</span>{%- endif -%}
              {%- if section.settings.assure_2 != blank -%}<span>{{ section.settings.assure_2 | escape }}</span>{%- endif -%}
              {%- if section.settings.assure_3 != blank -%}<span>{{ section.settings.assure_3 | escape }}</span>{%- endif -%}
            </div>
          </div>
        </div>

        {%- if accordion_items != blank -%}
          <div class="lz-acc">
            {%- for item in accordion_items -%}
              <details class="lz-acc__item"{% if forloop.first %} open{% endif %}>
                <summary class="lz-acc__q">{{ item.title.value | escape }}<span class="lz-acc__sign" aria-hidden="true"></span></summary>
                <div class="lz-acc__a">
                  {%- if item.intro_text.value != blank -%}<p>{{ item.intro_text.value | escape | newline_to_br }}</p>{%- endif -%}
                  {%- if item.check_list.value != blank -%}
                    <ul class="lz-list">
                      {%- for check_item in item.check_list.value -%}<li>{{ lz_check }}<span>{{ check_item | escape }}</span></li>{%- endfor -%}
                    </ul>
                  {%- endif -%}
                  {%- if item.steps.value != blank -%}
                    <div class="lz-steps">
                      {%- for step in item.steps.value -%}
                        <div class="lz-steps__item">
                          <span class="lz-steps__num">{{ step.step_number.value | default: forloop.index }}</span>
                          <div><strong>{{ step.title.value | escape }}</strong><br>{{ step.description.value | escape | newline_to_br }}</div>
                        </div>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                  {%- if item.outro_text.value != blank -%}<p>{{ item.outro_text.value | escape }}</p>{%- endif -%}
                </div>
              </details>
            {%- endfor -%}
          </div>
        {%- elsif faq_blocks.size > 0 -%}
          <div class="lz-acc">
            {%- for block in faq_blocks -%}
              <details class="lz-acc__item" {{ block.shopify_attributes }}{% if forloop.first %} open{% endif %}>
                <summary class="lz-acc__q">{{ block.settings.question | escape }}<span class="lz-acc__sign" aria-hidden="true"></span></summary>
                <div class="lz-acc__a">{{ block.settings.answer }}</div>
              </details>
            {%- endfor -%}
          </div>
        {%- endif -%}

        {%- if videos != blank -%}
          {% render 'product-video-gallery', product: product, uid: section.id %}
        {%- endif -%}
      </div>
    </div>
  </section>
  {%- endif -%}

  {%- if modal_here -%}
    <dialog class="lz-modal" id="LienzoModal-{{ section.id }}" aria-labelledby="LienzoModalTitle-{{ section.id }}" data-lz-modal>
      <header class="lz-modal__header">
        <h2 class="lz-modal__title" id="LienzoModalTitle-{{ section.id }}">{{ section.settings.modal_title | escape }}</h2>
        <button type="button" class="lz-modal__close" aria-label="{{ section.settings.modal_close_label | escape }}" data-lz-modal-close>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </button>
      </header>
      <div class="lz-modal__body">
        {%- if full_ingredients_content != blank -%}
          <div class="lz-modal__rte">{{ full_ingredients_content | metafield_tag }}</div>
        {%- endif -%}
      </div>
      {%- if modal_badges != blank -%}
        <footer class="lz-modal__footer">
          <ul class="lz-modal__badges" role="list">
            {%- for badge in modal_badges -%}
              {%- liquid
                assign badge_title = badge.title.value
                assign badge_icon = badge.icon.value
              -%}
              {%- if badge_title != blank or badge_icon != blank -%}
                <li class="lz-modal__badge">
                  {%- if badge_icon != blank -%}
                    {{ badge_icon | image_url: width: 96 | image_tag: class: 'lz-modal__badge-img', alt: badge_title, loading: 'lazy' }}
                  {%- endif -%}
                  {%- if badge_title != blank -%}<span>{{ badge_title | escape }}</span>{%- endif -%}
                </li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        </footer>
      {%- endif -%}
    </dialog>
  {%- endif -%}

  {%- liquid
    assign chart_heading = section.settings.chart_heading
    assign chart_image = blank
    assign chart_notes = section.settings.chart_sources
    if info != blank
      assign chart_heading = info.title.value | default: chart_heading
      assign chart_image = info.image.value
      assign chart_notes = info.notes.value | default: chart_notes
    endif
  -%}
  {%- if chart_heading != blank and show_chart -%}
    <section class="lz-chart">
      <div class="lz-chart__inner">
        <div class="lz-chart__text">
          <h2 class="lz-h2">{{ chart_heading | escape }}</h2>
          {%- if info.description.value != blank -%}
            <p>{{ info.description.value | escape | newline_to_br }}</p>
          {%- else -%}
            {{ section.settings.chart_text }}
          {%- endif -%}
        </div>
        <figure class="lz-chart__fig">
          {%- if chart_image != blank -%}
            {{ chart_image | image_url: width: 1200 | image_tag: class: 'lz-chart__img', loading: 'lazy', alt: chart_image.alt | default: chart_heading, sizes: '(min-width: 900px) 50vw, 100vw' }}
          {%- else -%}
            <svg viewBox="0 0 400 260" width="100%" role="img" aria-label="{{ chart_heading | escape }}">
              <line x1="40" y1="20" x2="40" y2="220" stroke="#C9D1CD"></line>
              <line x1="40" y1="220" x2="390" y2="220" stroke="#C9D1CD"></line>
              <line x1="40" y1="70" x2="390" y2="70" stroke="#E2E6E4" stroke-dasharray="3 4"></line>
              <line x1="40" y1="120" x2="390" y2="120" stroke="#E2E6E4" stroke-dasharray="3 4"></line>
              <line x1="40" y1="170" x2="390" y2="170" stroke="#E2E6E4" stroke-dasharray="3 4"></line>
              <path d="M70 220 L100 185 L190 125 L300 72 L380 62 L380 220 Z" fill="#BFE3D6"></path>
              <path d="M100 185 L190 125 L300 72 L380 62" fill="none" stroke="#1E6B4F" stroke-width="3"></path>
              <circle cx="100" cy="185" r="8" fill="#fff" stroke="#1E6B4F" stroke-width="3"></circle>
              <circle cx="190" cy="125" r="8" fill="#fff" stroke="#1E6B4F" stroke-width="3"></circle>
              <circle cx="300" cy="72" r="14" fill="#fff" stroke="#B42318" stroke-width="3"></circle>
              <rect x="216" y="6" width="170" height="40" rx="6" fill="#9A1F12"></rect>
              <text x="301" y="31" text-anchor="middle" font-size="14" font-weight="800" fill="#fff">{{ section.settings.chart_stat | escape }}</text>
              <text x="215" y="250" text-anchor="middle" font-size="12" fill="#55665F">{{ section.settings.chart_axis | escape }}</text>
            </svg>
          {%- endif -%}
          {%- if chart_notes != blank -%}
            <figcaption>{{ chart_notes | escape }}</figcaption>
          {%- endif -%}
        </figure>
      </div>
    </section>
  {%- endif -%}

  {%- if ing_has and show_ing -%}
    <section class="lz-ing" id="LienzoIngredientes">
      <div class="lz-ing__inner">
        <h2 class="lz-h2 lz-center">{{ section.settings.ingredients_heading | escape }}</h2>
        <div class="lz-ing__grid">
          {%- if ingredients != blank -%}
            {%- for item in ingredients -%}
              {%- liquid
                assign item_title = item.title.value | default: item.name.value
                assign item_description = item.description.value | default: item.text.value
                assign item_image = item.image.value | default: item.photo.value
                assign item_tag = item.benefit.value | default: item.benefits.value | default: item.tag.value | default: item.badge.value | default: item.category.value | default: item.label.value
              -%}
              <article class="lz-ing__card">
                <div class="lz-ing__media">
                  {%- if item_tag != blank -%}<span class="lz-ing__tag">{{ item_tag | escape }}</span>{%- endif -%}
                  {%- if item_image != blank -%}
                    {{ item_image | image_url: width: 700 | image_tag: alt: item_title, loading: 'lazy' }}
                  {%- endif -%}
                </div>
                <div class="lz-ing__body">
                  <h3>{{ item_title | escape }}</h3>
                  <p>{{ item_description | escape | newline_to_br }}</p>
                </div>
              </article>
            {%- endfor -%}
          {%- else -%}
            {%- for block in ingredient_blocks -%}
              <article class="lz-ing__card" {{ block.shopify_attributes }}>
                <div class="lz-ing__media">
                  {%- if block.settings.tag != blank -%}<span class="lz-ing__tag">{{ block.settings.tag | escape }}</span>{%- endif -%}
                  {%- if block.settings.image != blank -%}
                    {{ block.settings.image | image_url: width: 700 | image_tag: alt: block.settings.name, loading: 'lazy' }}
                  {%- endif -%}
                </div>
                <div class="lz-ing__body">
                  <h3>{{ block.settings.name | escape }}</h3>
                  <p>{{ block.settings.description | escape }}</p>
                </div>
              </article>
            {%- endfor -%}
          {%- endif -%}
        </div>
        {%- if has_modal -%}
          <button type="button" class="lz-btn-coral lz-btn-coral--inline" aria-haspopup="dialog" aria-controls="LienzoModal-{{ section.id }}" data-lz-modal-open>
            {{ section.settings.ingredients_button | escape }}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </button>
        {%- elsif section.settings.ingredients_url != blank -%}
          <a class="lz-btn-coral lz-btn-coral--inline" href="{{ section.settings.ingredients_url }}">{{ section.settings.ingredients_button | escape }}</a>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- if show_trust -%}
    {%- capture trust_items -%}
      {%- if highlights != blank -%}
        {%- for highlight in highlights -%}
          <li class="lz-trust__item"><svg class="lz-trust__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B5EE8A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>{{ highlight | strip | escape }}</li>
        {%- endfor -%}
      {%- else -%}
        {%- for block in trust_blocks -%}
          <li class="lz-trust__item" {{ block.shopify_attributes }}><svg class="lz-trust__icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#B5EE8A" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"></path></svg>{{ block.settings.text | escape }}</li>
        {%- endfor -%}
      {%- endif -%}
    {%- endcapture -%}
    {%- if trust_items != blank -%}
      <div class="lz-trust{% if section.settings.trust_respect_motion %} lz-trust--respect{% endif %}" style="--lz-trust-duration: {{ section.settings.trust_speed | default: 40 }}s;">
        <div class="lz-trust__track">
          {%- for group in (1..2) -%}
            <div class="lz-trust__group"{% if group == 2 %} aria-hidden="true"{% endif %}>
              {%- for repeat in (1..3) -%}
                <ul class="lz-trust__set{% if repeat > 1 %} lz-trust__set--copy{% endif %}" role="list"{% if repeat > 1 %} aria-hidden="true"{% endif %}>{{ trust_items }}</ul>
              {%- endfor -%}
            </div>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endif -%}

  {%- if cmp_has and show_compare -%}
    {%- liquid
      assign cmp_heading = titles_entry.title.value | default: section.settings.compare_heading
      assign cmp_sub = titles_entry.subtitle.value | default: section.settings.compare_text
      assign cmp_outro = titles_entry.outro.value | default: section.settings.compare_note
    -%}
    <section class="lz-compare">
      <h2 class="lz-h2 lz-center">{{ cmp_heading | escape }}</h2>
      {%- if cmp_sub != blank -%}<p class="lz-compare__lead">{{ cmp_sub | escape }}</p>{%- endif -%}
      <div class="lz-compare__scroll">
        <table class="lz-compare__table">
          <thead>
            <tr>
              <th scope="col"><span class="visually-hidden">{{ cmp_heading | escape }}</span></th>
              {%- if competitors != blank -%}
                {%- for competitor in competitors limit: 3 -%}
                  <th scope="col"{% if forloop.first %} class="lz-col-us lz-col-us--top"{% endif %}>
                    {%- if competitor.image.value != blank -%}{{ competitor.image.value | image_url: width: 160 | image_tag: alt: '', class: 'lz-compare__img', loading: 'lazy' }}{%- endif -%}
                    {{ competitor.name.value | escape }}
                  </th>
                {%- endfor -%}
              {%- else -%}
                <th scope="col" class="lz-col-us lz-col-us--top">
                  {%- if product.featured_media -%}{{ product.featured_media | image_url: width: 120 | image_tag: alt: '', class: 'lz-compare__img' }}{%- endif -%}
                  {{ section.settings.compare_us | escape }}
                </th>
                <th scope="col">{{ section.settings.compare_a | escape }}</th>
                <th scope="col">{{ section.settings.compare_b | escape }}</th>
              {%- endif -%}
            </tr>
          </thead>
          <tbody>
            {%- if rows != blank -%}
              {%- for row in rows -%}
                {%- capture packed -%}{{ row.our_value.value | strip }}§§{{ row.competitor_1_value.value | strip }}§§{{ row.competitor_2_value.value | strip }}{%- endcapture -%}
                {%- assign values = packed | split: '§§' -%}
                <tr>
                  <th scope="row">{{ row.feature_name.value | escape }}</th>
                  {%- for index in (0..2) -%}
                    {%- assign cell = values[index] | strip -%}
                    {%- assign cell_key = cell | downcase -%}
                    <td{% if index == 0 %} class="lz-col-us{% if forloop.parentloop.last %} lz-col-us--bottom{% endif %}"{% endif %}>
                      {%- if cell_key == 'check' or cell_key == 'true' or cell_key == '✓' or cell_key == 'yes' or cell_key == 'si' or cell_key == 'sí' -%}
                        <span class="lz-icon lz-icon--yes" role="img" aria-label="Sí"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"></polyline></svg></span>
                      {%- elsif cell_key == 'cross' or cell_key == 'false' or cell_key == 'x' or cell_key == '✕' or cell_key == 'no' -%}
                        <span class="lz-icon lz-icon--no" role="img" aria-label="No"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.2" stroke-linecap="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg></span>
                      {%- else -%}
                        {{ cell | escape }}
                      {%- endif -%}
                    </td>
                  {%- endfor -%}
                </tr>
              {%- endfor -%}
            {%- else -%}
              {%- for block in compare_blocks -%}
                <tr {{ block.shopify_attributes }}>
                  <th scope="row">{{ block.settings.feature | escape }}</th>
                  <td class="lz-col-us{% if forloop.last %} lz-col-us--bottom{% endif %}">{{ block.settings.us | escape }}</td>
                  <td>{{ block.settings.a | escape }}</td>
                  <td>{{ block.settings.b | escape }}</td>
                </tr>
              {%- endfor -%}
            {%- endif -%}
          </tbody>
        </table>
      </div>
      {%- if cmp_outro != blank -%}<p class="lz-compare__note">{{ cmp_outro | escape }}</p>{%- endif -%}
    </section>
  {%- endif -%}
</div>

{% stylesheet %}
  .lz-btn-coral { gap: 8px; font: inherit; font-weight: 700; cursor: pointer; }
  .lz-modal { width: min(720px, calc(100% - 32px)); max-height: calc(100dvh - 48px); padding: 0; border: 0; border-radius: 16px; color: #0E3B2E; background: #fff; box-shadow: 0 24px 64px rgb(14 59 46 / 0.25); overflow: hidden; }
