  .lz-tab.is-active { background: #fff; color: #1A7F56; }
  .lz-tabs__panel { background: #fff; border-radius: 0 0 10px 10px; padding: 18px 22px; }
  .lz-checks ul { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 12px; }
  .lz-checks li { position: relative; padding-inline-start: 30px; }
  .lz-checks li::before { content: ''; position: absolute; left: 2px; top: 6px; width: 12px; height: 7px; border-left: 2.5px solid #1A7F56; border-bottom: 2.5px solid #1A7F56; transform: rotate(-45deg); }
  .lz-checks p, .lz-dosage p { margin: 0 0 10px; }
  .lz-dosage table { width: 100%; border-collapse: collapse; font-size: 15px; }
  .lz-dosage th, .lz-dosage td { text-align: left; padding: 12px 0; border-top: 1px solid #E5ECE8; }
  .lz-tab-ingredients { display: flex; flex-direction: column; gap: 16px; }
  .lz-tab-ingredients p { margin: 0; }
  .lz-mini-ing { display: flex; gap: 14px; align-items: flex-start; }
  .lz-mini-ing__img { flex: none; width: 52px; height: 52px; border-radius: 50%; background: #BFE3D6; overflow: hidden; }
  .lz-mini-ing__img img { width: 100%; height: 100%; object-fit: cover; }
  .lz-btn-coral { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: 0 36px; border: 1px solid #E0715A; background: #FFF4F1; border-radius: 999px; color: #B42318 !important; font-weight: 700; text-decoration: none; }
  .lz-btn-coral--inline { display: inline-flex; margin: 40px auto 0; }

  .lz-card { background: #F3F4F3; border-radius: 12px; padding: 6px; }
  .lz-card__inner { background: #fff; border-radius: 10px; padding: 18px 20px; display: flex; flex-direction: column; gap: 18px; }
  .lz-tip { padding: 12px 14px; background: #F2FBF7; border-radius: 8px; font-size: 15px; }
  .lz-tip p { margin: 0; }
  .lz-form { display: flex; flex-direction: column; gap: 18px; }
  .lz-step { display: flex; flex-direction: column; gap: 10px; }
  .lz-step__label { display: flex; align-items: center; gap: 10px; margin: 0; font-weight: 800; }
  .lz-step__num { width: 24px; height: 24px; border-radius: 50%; background: #1A7F56; color: #fff; display: inline-flex; align-items: center; justify-content: center; font-size: 13px; }
