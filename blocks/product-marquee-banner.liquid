{% render 'product-marquee-banner', product: closest.product, block: block, speed: block.settings.speed %}

{% schema %}
{
  "name": "Banda de resaltados",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "speed",
      "label": "Duración del ciclo (segundos)",
      "min": 20,
      "max": 300,
      "step": 10,
      "default": 150
    }
  ],
  "presets": [
    {
      "name": "Banda de resaltados",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
