{%- comment -%}
  Información Destacada
  Accepts:
  - product: {Object} Product object (defaults to the product in context)
  - block: {Object} Optional block, used for shopify_attributes
{%- endcomment -%}

{%- liquid
  assign info_product = product
  if request.visual_preview_mode and info_product == blank
    assign info_product = collections.all.products.first
  endif
  assign info = info_product.metafields.custom.first_nformation.value
-%}

{%- if info != blank -%}
  {%- liquid
    assign info_title = info.title.value
    assign info_description = info.description.value
    assign info_image = info.image.value
    assign info_notes = info.notes.value
  -%}

  <div class="first-information" {{ block.shopify_attributes }}>
    <div class="first-information__inner">
      {%- if info_title != blank or info_description != blank -%}
        <div class="first-information__text">
          {%- if info_title != blank -%}
            <h2 class="first-information__title">{{ info_title | escape }}</h2>
          {%- endif -%}
          {%- if info_description != blank -%}
            <div class="first-information__description">
              {{- info_description | escape | newline_to_br -}}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if info_image != blank or info_notes != blank -%}
        <div class="first-information__media">
          {%- if info_image != blank -%}
            {{
              info_image
              | image_url: width: 1200
              | image_tag:
                class: 'first-information__image',
                loading: 'lazy',
                widths: '400, 600, 800, 1000, 1200',
                sizes: '(min-width: 768px) 50vw, 100vw',
                alt: info_image.alt
            }}
          {%- endif -%}
          {%- if info_notes != blank -%}
            <p class="first-information__notes">{{ info_notes | escape }}</p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
    .first-information {
      position: relative;
      grid-column: 1 / -1;
      width: 100%;
      padding-block: 40px;
      isolation: isolate;
    }

    /* Full-bleed background, even inside a constrained grid */
    .first-information::before {
      content: '';
      position: absolute;
      inset-block: 0;
      left: 50%;
      width: 100vw;
      transform: translateX(-50%);
      background-color: #f8fafa;
      z-index: -1;
    }

    .first-information__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: 24px;
      align-items: start;
    }

    .first-information__title {
      margin: 0 0 20px;
      font-size: 28px;
      font-weight: 700;
      line-height: 1.2;
      color: #0E3B2E;
    }

    .first-information__description {
      font-size: 15px;
      line-height: 1.6;
      color: #333;
    }

    .first-information__image {
      display: block;
      width: 100%;
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }

    .first-information__notes {
      margin: 12px 0 0;
      font-size: 12px;
      line-height: 1.5;
      color: #777;
    }

    @media screen and (min-width: 768px) {
      .first-information {
        padding-block: 60px;
      }

      .first-information__inner {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 48px;
      }

      .first-information__title {
        font-size: 32px;
      }

      .first-information__description {
        font-size: 16px;
      }

      .first-information__notes {
        font-size: 13px;
      }
    }
{% endstylesheet %}
