{% doc %}
  Featured testimonial, read from the product's `custom.expert_testimonial`
  metafield (a metaobject with image, text, name and description).

  @param {object} product - The product whose testimonial is rendered.
{% enddoc %}

{%- assign testimonial = product.metafields.custom.expert_testimonial.value -%}

{%- if testimonial != blank -%}
  {%- liquid
    assign photo = testimonial.image.value
    assign quote = testimonial.text.value
    assign person_name = testimonial.name.value
    assign person_role = testimonial.description.value
  -%}

  {%- if quote != blank or person_name != blank -%}
    <figure class="product-testimonial">
      {%- if photo != blank -%}
        {{
          photo
          | image_url: width: 200
          | image_tag:
            class: 'product-testimonial__photo',
            widths: '100, 200',
            sizes: '96px',
            loading: 'lazy',
            alt: person_name
        }}
      {%- endif -%}

      <div class="product-testimonial__body">
        {%- if quote != blank -%}
          <blockquote class="product-testimonial__quote">{{ quote | escape | newline_to_br }}</blockquote>
        {%- endif -%}

        {%- if person_name != blank or person_role != blank -%}
          <figcaption class="product-testimonial__author">
            {%- if person_name != blank -%}
              <span class="product-testimonial__name">{{ person_name | escape }}</span>
            {%- endif -%}
            {%- if person_role != blank -%}
              <span class="product-testimonial__role">{{ person_role | escape }}</span>
            {%- endif -%}
          </figcaption>
        {%- endif -%}
      </div>
    </figure>
  {%- endif -%}
{%- elsif request.design_mode -%}
  <p class="product-testimonial product-testimonial--empty">
    Este bloque se muestra cuando el producto tiene un testimonio en <code>custom.expert_testimonial</code>.
  </p>
{%- endif -%}

{% stylesheet %}
  .product-testimonial {
    box-sizing: border-box;
    width: 100%;
    grid-column: 1 / -1;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 24px;
    margin: 0;
    padding: 24px;
    border: 1px solid #dcefec;
    border-radius: 8px;
    background: #F2FBF7;
    font-family: var(--font-body--family);
  }

  .product-testimonial__photo {
    flex: 0 0 auto;
    width: 96px;
    height: 96px;
    border: 3px solid #0E3B2E;
    border-radius: 50%;
    object-fit: cover;
  }

  .product-testimonial__body {
    min-width: 0;
  }

  .product-testimonial__quote {
    margin: 0 0 14px;
    padding: 0;
    border: 0;
    color: #1f1f1f;
    font-size: 16px;
    font-style: italic;
    line-height: 1.5;
  }

  .product-testimonial__author {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .product-testimonial__name {
    color: #1f1f1f;
    font-size: 14px;
    font-weight: 600;
    line-height: 1.3;
  }

  .product-testimonial__role {
    color: #666666;
    font-size: 13px;
    font-weight: 400;
    line-height: 1.3;
  }

  .product-testimonial--empty {
    display: block;
    border: 1px dashed #E5ECE8;
    background: #f7f9f8;
    color: #55665F;
    font-size: 13px;
  }

  @media screen and (max-width: 748px) {
    .product-testimonial {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .product-testimonial__author {
      align-items: center;
    }
  }
{% endstylesheet %}
